import {createRun,act,reading,saveSnapshot,compatible,validate} from './model.mjs';
import {validate as validateLegacy} from './legacy-model.mjs';
import {renderBench,teacherSVG} from './bench.mjs';
import {createHold} from './hold.mjs';
const $=s=>document.querySelector(s),esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const KEY='yu-buoyancy-prototype-v1.2-g10', LEGACY_KEY='yu-buoyancy-prototype-v1.1';let legacyData=null,legacyRecords=[],legacyRaw='',legacyMessage='';let records=[],revisions={},drafts={},storageOK=true,storageMessage='',message='',settleTimer=null,run=createRun('water');let draft={w:'',difference:'',displaced:'',explanation:''},comparison='';
try{const saved=JSON.parse(localStorage.getItem(KEY)||'null');if(saved){records=Array.isArray(saved.records)?saved.records.filter(x=>x&&x.modelVersion&&x.runId&&x.fluidId&&x.evidence&&x.valid&&x.calcCorrect&&x.evidence.mass&&x.explanation&&x.idempotencyKey===x.runId&&!validate(x)):[];revisions=saved.revisions||{};drafts=saved.drafts||{};comparison=saved.comparison||''}localStorage.setItem(KEY,JSON.stringify({records,revisions,drafts,comparison}));}catch{storageOK=false;storageMessage='本機儲存目前無法使用；操作仍可繼續，離開前請複製紀錄。';}
try{legacyRaw=localStorage.getItem(LEGACY_KEY)||'';if(legacyRaw){legacyData=JSON.parse(legacyRaw);legacyRecords=Array.isArray(legacyData?.records)?legacyData.records.filter(x=>x&&x.valid&&x.calcCorrect&&x.evidence?.mass&&x.explanation&&x.idempotencyKey===x.runId&&!validateLegacy(x)):[];legacyMessage='舊版 g＝9.8 N/kg 的資料已保留為唯讀封存，不會重新計算，也不參與本版比較。'}}catch{legacyMessage='舊版封存暫時無法讀取；原資料未被修改。'}
draft.explanation=drafts.water||'';
function persist(){try{localStorage.setItem(KEY,JSON.stringify({records,revisions,drafts,comparison}));storageOK=true;storageMessage=''}catch{storageOK=false;storageMessage='本機儲存失敗。紀錄只留在本頁記憶體，離開前請複製紀錄。'} }
function eVal(e){return e?.value}
function next(){if(!run.valid)return ['reset','重新準備這一輪','這輪程序已失效，舊的有效紀錄仍然保留。'];if(!run.zeroed)return ['zero','空秤歸零','先讓空的彈簧秤回到零。'];if(!run.hung)return ['hang','掛上乾燥鋁塊','點按按鈕，或將鋁塊拖到吊架掛鉤。'];if(!run.evidence.W)return ['recordW','記下空氣中讀值 W','鋁塊懸空、不碰水，現在可以留下本輪基準。'];if(!run.wConfirmed)return ['w','確認我的抄讀','看看彈簧秤，將你讀到的數字填在觀察問題。'];if(run.filling)return ['wait','等待準備滴流停止…','準備液只流入廢液杯，不計入本次排液。'];if(!run.tankReady){if(!run.wasteAtOutlet)return ['placeWaste','放廢液杯到出口','先放廢液杯，再把槽加到溢流口。'];return ['fill','加液到溢流口','鋁塊仍在槽口上方；多出的液體流入廢液杯。'];}if(run.wasteAtOutlet)return ['removeWaste','移走廢液杯','出口一次只放一只杯；先移走廢液杯。'];if(!run.tareId){if(run.cupLocation!=='scale')return ['cupToScale','空收集杯放上天平','用同一只乾淨的空杯去皮。'];return ['tare','空杯去皮','扣掉空杯的重量，確認天平顯示 0.0 g。'];}if(!run.evidence.T){if(run.cupLocation!=='outlet')return ['cupToOutlet','收集杯放到出口','去皮後的同一只杯，才能收集本輪排液。'];if(run.dripping)return ['wait','等這一格滴流停止…','杯中液體＋出口待流出的液體，等於已排出體積。'];if(run.f<1)return ['lower','向下降低一格','每格浸入 10%；可按住連續向下，放開即停。'];return ['recordT','記下液中讀值 T','已完全浸沒、吊架鎖定，沒有碰到槽底或槽壁。'];}if(!run.observed)return ['observe','先回答讀值變化','把 W 與 T 並排看；讀值變大、變小，還是一樣？'];if(!run.evidence.mass){if(run.cupLocation!=='scale')return ['cupToScale','收集杯移到天平','滴流已停止。不要再去皮，直接讀液體淨質量。'];return ['recordMass','記下排液質量','記下同一只收集杯裡的液體淨質量。'];}if(!run.calcCorrect)return ['calculate','核對我的計算','用本輪證據自己算：W−T，以及排液質量 × g。'];if(!records.some(x=>x.runId===run.runId))return ['save','保存這輪證據','寫下你的觀察與引用的證據，再保存這一輪。'];if(run.fluidId==='water')return ['brine','換濃鹽水開新輪','清水已留存。只換液體，再完整量一次。'];return ['done','兩輪證據已留存','到下方比較兩輪，寫下你的解釋。'];}
function phase(){if(!run.wConfirmed)return 1;if(!run.evidence.T)return 2;if(!records.some(x=>x.runId===run.runId))return 3;return 4}
function teacher(){const [a,,hint]=next();return ({zero:'今天不用先猜。我們先量同一塊鋁塊，再用排出的液體找證據。',fill:'先加滿到溢流口。等滴流停了，才換上實驗用的收集杯。',lower:'慢慢向下降低吊架，觀察秤值和排液。完全浸沒時，也不要碰底或碰壁。',calculate:'先自己算算看。注意排液質量的單位：g 要換成 kg，再乘以 10 N/kg。',save:'數字相同不代表真實實驗沒有誤差。這裡是理想模型；請說說你看到了什麼。',brine:'第一輪存好了。下一輪只換濃鹽水，空秤歸零、空氣中量測都要重新做。'})[a]||hint}
function question(){if(run.evidence.W&&!run.wConfirmed)return `<h3 id="question-title">觀察問題 · 抄下讀值</h3><p>你剛才讀到多少 N？</p><form data-form="w"><div class="field"><label for="w">空氣中 W</label><input id="w" name="w" inputmode="decimal" autocomplete="off" value="${esc(draft.w)}"><span>N</span></div><button type="submit">確認我的抄讀</button></form>`;if(run.evidence.T&&!run.observed)return `<h3 id="question-title">觀察問題 · 讀值變化</h3><p>和空氣中的 W 比，現在的 T 如何？</p><div class="action-line">${[['larger','變大'],['smaller','變小'],['same','一樣']].map(([a,t])=>`<button data-observe="${a}">${t}</button>`).join('')}</div>`;if(run.evidence.mass&&!run.calcCorrect)return `<h3 id="question-title">自己算，再核對</h3><p class="hint"><strong>本版 g＝10 N/kg</strong>；質量先用 g ÷ 1000 換成 kg，再乘以 10。</p><form data-form="calculate"><div class="field"><label for="difference">W − T</label><input id="difference" name="difference" inputmode="decimal" value="${esc(draft.difference)}"><span>N</span></div><div class="field"><label for="displaced">排液重量</label><input id="displaced" name="displaced" inputmode="decimal" value="${esc(draft.displaced)}"><span>N</span></div><details><summary>我想看單位提示</summary>g ÷ 1000 → kg；重量＝質量（kg）× 10 N/kg。</details><button type="submit" class="primary">核對我的計算</button></form>`;if(run.calcCorrect)return `<h3 id="question-title">用自己的話解釋</h3><p>在本理想模型中，讀值差等於排液重量。液體向上提供浮力，鋁塊本身的重量沒有改變。</p><p><strong>${force(run.evidence.W)} − ${force(run.evidence.T)} ＝ ${(run.calculation.difference/1000).toFixed(3)} N</strong></p><label class="hint" for="explanation">我觀察到＿＿；我用＿＿與＿＿作為證據。</label><textarea id="explanation" name="explanation" placeholder="留下你的觀察與引用的數值…">${esc(draft.explanation)}</textarea><button data-action="draft" class="soft small">保留解釋草稿</button>`;return `<h3>觀察問題</h3><p class="hint">先動手量測，取得證據後再回答。這裡不需要先猜對。</p>`}
function force(e){return (Number(eVal(e))/1000).toFixed(3)}
function evidenceHTML(){return [['W','空氣中重量 W','N'],['T','液中讀值 T','N'],['mass','排液淨質量','g']].map(([k,l,u])=>`<div class="evidence-item ${run.evidence[k]?'':'empty'}"><div class="row"><span>${l}</span><b>${run.evidence[k]?((Number(eVal(run.evidence[k]))/(k==='mass'?1:1000)).toFixed(k==='mass'?1:3)+' '+u):'尚未量測'}</b></div></div>`).join('')}
function savedHTML(r,i,legacy=false){const ev=r.evidence;return `<article class="saved-card"><h3>${r.fluidId==='water'?'清水':'濃鹽水'} <span class="badge">${legacy?'舊版唯讀 · g＝9.8':'有效模型證據 '+(i+1)}</span></h3><dl><dt>空氣中重量 W</dt><dd>${force(ev.W)} N</dd><dt>液中讀值 T</dt><dd>${force(ev.T)} N</dd><dt>排液淨質量</dt><dd>${Number(eVal(ev.mass)).toFixed(1)} g</dd><dt>完全浸沒體積</dt><dd>50 cm³</dd><dt>模型 g</dt><dd>${esc(r.g)} N/kg</dd><dt>W − T／排液重量</dt><dd>${(r.calculation.difference/1000).toFixed(3)} N</dd></dl><blockquote>${esc((legacy?legacyData?.revisions:revisions)?.[r.runId]?.at(-1)?.text||r.explanation)}</blockquote>${legacy?'':`<button class="soft small" data-edit="${esc(r.runId)}">另存解釋修訂</button>`}<p class="hint">${esc(r.runId)} · 原始讀值不覆寫</p></article>`}
function render(){const n=next(),rr=reading(run),p=phase(),pair=records.some(a=>records.some(b=>compatible(a,b)));const scale=run.cupLocation==='scale'?(run.tareId?Number(rr.massG).toFixed(1):'—'):'—';$('#app').innerHTML=`<header><div class="brand">余老師的科學小屋<span>SCIENCE, ONE SMALL DISCOVERY AT A TIME</span></div><span class="badge">教學互動原型 · 非實物量測</span></header><main class="shell"><section class="intro"><div><p class="eyebrow">EXPERIMENT 01 / 浮力與排液</p><h1>少掉的讀值，<em>去哪裡了？</em></h1><p class="subtitle">同一塊鋁塊，兩種液體。一起量出浮力的證據。</p></div><span class="badge">不必先猜 · 動手再說</span></section><nav class="chapter" aria-label="四步實驗">${['空氣中讀秤','準備與浸入','秤排液・計算','換液再比較'].map((t,i)=>`<button data-tab="${i+1}" class="${p===i+1?'current':''}" ${p===i+1?'aria-current="step"':''}><span class="num">${i+1}</span>${t}</button>`).join('')}</nav>${storageMessage?`<div role="status" class="notice">${esc(storageMessage)}</div>`:''}${!run.valid?`<div role="alert" class="notice">本輪已失效：${esc(run.invalidReason)}</div>`:''}<div class="workspace"><section class="panel"><div class="bench-head"><div><p class="eyebrow">你的實驗桌 / ROUND ${run.fluidId==='water'?'01':'02'}</p><h2>${n[1].replace('…','')}</h2></div><span class="fluid">${run.fluidId==='water'?'清水 · 1000':'濃鹽水 · 1200'} kg/m³</span></div><p class="hint" style="padding:0 23px;margin-bottom:0">鋁塊 A · 體積 50 cm³ · 模型密度 2700 kg/m³</p><div class="bench">${renderBench({...run,forceText:run.zeroed?Number(rr.forceN).toFixed(3)+' N':'— N',massText:scale+' g'})}</div><div class="instrument-row"><div class="instrument"><div class="label">彈簧秤讀值 · N</div><div class="number">${run.zeroed?Number(rr.forceN).toFixed(3):'—'} <small>N</small></div><div class="status">${run.hung?(run.dripping?'準靜態示意 · 滴流中':run.f===1?'完全浸沒 · 吊架已鎖定':'懸吊中 · 未碰底壁'):'空秤 · '+(run.zeroed?'已歸零':'尚未歸零')}</div></div><div class="instrument"><div class="label">電子天平 · 液體淨質量</div><div class="number">${scale} <small>g</small></div><div class="status">${run.cupLocation==='scale'?(run.tareId?'同杯去皮基準有效':'空杯尚未去皮'):'等待收集杯放上天平'}</div></div></div><div class="action-zone"><div class="action-line"><button class="primary" data-action="${n[0]}" ${['wait','done','observe','w','calculate'].includes(n[0])?'disabled':''} ${n[0]==='lower'?'id="lower"':''}>${n[0]==='lower'?'↓ ':''}${n[1]}</button>${run.f>0&&run.valid?'<button class="soft" data-action="up">向上取出／重做</button>':''}</div><p class="hint">${n[2]}</p><p class="hint">浸入體積：${Math.round(run.f*100)}% · ${run.dripping?'出口正在滴流':'滴流已停止'}${run.f>0?' · 杯中 '+Number(run.cupVolume).toFixed(0)+' cm³ ＋ 待流 '+Number(run.pendingVolume).toFixed(0)+' cm³':''}</p><div id="message" class="message" role="status" aria-live="polite">${esc(message)}</div></div></section><aside class="panel side"><section class="teacher">${teacherSVG}<div><p class="eyebrow">余老師的小提醒</p><p>${teacher()}</p></div></section><section class="evidence"><p class="eyebrow">只留這一輪的原始讀值</p><h3>我的證據卡</h3>${evidenceHTML()}</section><section class="question">${question()}</section></aside></div><section class="saved"><div class="section-title"><h2>實驗手札 <span class="subtitle">／ 已留存 ${records.length} 輪</span></h2><button class="soft small" data-action="copy">複製紀錄</button></div><div class="saved-grid">${records.length?records.map(savedHTML).join(''):'<div class="empty-saved">你的第一組證據會出現在這裡。先量測，再計算，最後寫下觀察。</div>'}</div>${pair?`<section class="compare"><p class="eyebrow">SAME OBJECT, DIFFERENT LIQUID</p><h3>兩組證據放在一起看</h3><p>兩次完全浸沒體積相同。哪一輪的排液重量較大？哪兩個數字支持你？鋁塊的 W 有沒有變？你能用密度解釋 T 的差異嗎？</p><label for="comparison" class="hint">請用自己的話把密度、排液重量與浮力連起來。</label><textarea id="comparison" name="comparison">${esc(comparison)}</textarea><button class="primary" data-action="compare">保存比較解釋</button><p class="hint">已留下兩組可比較的模型證據；完成活動不等於已精熟概念。</p></section>`:''}</section>${legacyRaw||legacyMessage?`<section class="saved"><h2>舊版手札封存 · g＝9.8 N/kg</h2><p class="hint">${esc(legacyMessage)}</p><div class="saved-grid">${legacyRecords.map((r,i)=>savedHTML(r,i,true)).join('')}</div>${legacyData?`<details><summary>查看舊版草稿與比較解釋</summary><p>清水草稿：${esc(legacyData.drafts?.water||'未保存')}</p><p>濃鹽水草稿：${esc(legacyData.drafts?.brine||'未保存')}</p><p>比較解釋：${esc(legacyData.comparison||'未保存')}</p></details>`:''}<p class="hint">舊版資料不會改寫成 g＝10；「複製紀錄」也會保留原始封存內容。</p></section>`:''}<footer class="foot"><div class="footer-row"><p>${storageOK?'只儲存在這個瀏覽器':'目前只保留在頁面記憶體'} · 不會提交給老師<br>重新整理會從乾燥的新輪開始，不恢復半輪實驗。</p><div class="tools"><button class="reset" data-action="reset">重新準備本輪</button><button class="reset" data-action="clear">清除本版手札</button></div></div><details><summary>模型設定與操作說明</summary><p>鋁塊 A：體積 50 cm³、密度 2700 kg/m³；g＝10 N/kg。清水與濃鹽水密度是教材指定名目值，不代表所有實際液體。本頁忽略空氣浮力、吊繩排水、附著液滴與流動阻力。降低期間顯示準靜態示意，不是真實瞬時量測。</p><p>每次向下降低 10%，只接受完全浸沒的正式 T。向上操作會先詢問重做；取消不改變本輪。所有拖曳都有旁邊按鈕替代，鍵盤 Tab、Enter／Space 可完成。</p><p>本原型的數字核對採精確毫牛頓，不是實驗誤差容許值。真實實驗需考慮儀器解析度、零點、滴液損失與量測不確定度。</p></details></footer></main>`;bind()}
const hold=createHold({step:()=>{if(run.valid&&next()[0]==='lower')dispatch('lower')},delay:430});
function captureDraft(){for(const k of ['w','difference','displaced','explanation']){const e=$(`[name="${k}"]`);if(e)draft[k]=e.value}if($('#comparison'))comparison=$('#comparison').value}
function announce(s){message=s;const e=$('#message');if(e)e.textContent=s}
function dispatch(action,payload={}){captureDraft();try{const old=run;run=act(run,action,payload);if(run===old)return;if(run.f===1)hold.stop();message=({zero:'空秤已歸零。',recordW:'已記下本輪 W。請抄下你讀到的數字。',tare:'空杯去皮完成：0.0 g。',recordT:'已記下本輪 T。請比較兩張讀值卡。',recordMass:'排液質量已記錄。現在輪到你自己計算。',calculate:'兩個計算都正確。接著寫下你的觀察。',transcribeW:'抄讀確認，準備溢流槽吧。',observe:'觀察確認。可以把收集杯移到天平。'})[action]||'';if(run.dripping){clearTimeout(settleTimer);const expectedRunId=run.runId,expectedRevision=run.revision;settleTimer=setTimeout(()=>dispatch('settle',{expectedRunId,expectedRevision}),run.filling?950:290)}render();if(['recordW','recordT','recordMass','calculate'].includes(action)){const h=$('#question-title');if(h){h.tabIndex=-1;h.focus({preventScroll:true})}}}catch(e){announce(e.message)}}
function reset(fluid=run.fluidId){hold.stop();clearTimeout(settleTimer);run=createRun(fluid);draft={w:'',difference:'',displaced:'',explanation:drafts[fluid]||''};message='已開始新輪：槽與杯排空，鋁塊恢復乾燥。';render()}
function confirmReset(fluid=run.fluidId){hold.stop();if(confirm('要重新開始這輪嗎？\n當輪操作會清空，已保存的證據會保留。取消則完全不改變物理狀態。'))reset(fluid)}
async function action(a){captureDraft();if(a==='up'||a==='reset')return confirmReset();if(a==='brine')return confirmReset('brine');if(a==='save'){try{run=act(run,'explain',{text:draft.explanation});const snap=saveSnapshot(run);if(!records.some(x=>x.runId===snap.runId))records.push(snap);persist();message=storageOK?'這輪證據已儲存在本機。不會提交給老師。':'這輪證據僅留在頁面記憶體；請離開前複製。';render()}catch(e){announce(e.message)}return}if(a==='draft'){drafts[run.fluidId]=draft.explanation;persist();render();announce(storageOK?'解釋草稿已保留在本機。':'草稿只留在本頁；本機儲存失敗。');return}if(a==='compare'){if(!comparison.trim())return announce('請先寫下你的比較解釋。');persist();render();announce(storageOK?'比較解釋已保存在本機。':'比較解釋僅留在頁面記憶體。');return}if(a==='clear'){if(confirm('確定清除本版 g＝10 的手札、解釋修訂與草稿？舊版唯讀封存會保留。取消不會改變資料。')){records=[];revisions={};drafts={};comparison='';persist();reset()}return}if(a==='copy'){const data=JSON.stringify({notice:'理想化教學模型；不是真實儀器量測；不會提交老師',records,revisions,drafts,comparison,legacyArchive:legacyRaw},null,2);try{await navigator.clipboard.writeText(data);announce('紀錄已複製，可貼到自己的筆記保存。')}catch{const d=document.createElement('dialog');d.innerHTML='<h3>複製你的紀錄</h3><p>請全選以下內容並複製。</p><textarea style="min-height:240px" aria-label="完整紀錄"></textarea><button>關閉</button>';d.querySelector('textarea').value=data;d.querySelector('button').onclick=()=>d.remove();document.body.append(d);d.showModal();d.querySelector('textarea').select()}return}if(!['done','wait','observe','calculate','w'].includes(a))dispatch(a)}
let lastLowerDown=-Infinity;
function bind(){document.querySelectorAll('[data-action]').forEach(b=>{if(b.dataset.action==='lower'){b.addEventListener('pointerdown',e=>{if(e.button!==0)return;e.preventDefault();const now=performance.now();if(now-lastLowerDown<320)return;lastLowerDown=now;hold.start();document.body.setPointerCapture?.(e.pointerId)});b.addEventListener('click',e=>{if(e.detail>1)return;if(e.detail===0){hold.clearSuppression();hold.click()}else hold.click()})}else b.addEventListener('click',e=>{if(e.detail>1)return;action(b.dataset.action)})});document.querySelectorAll('[data-observe]').forEach(b=>b.onclick=()=>dispatch('observe',{answer:b.dataset.observe}));document.querySelectorAll('[data-tab]').forEach(b=>b.onclick=()=>announce(Number(b.dataset.tab)===phase()?'你正在這個步驟。':'四步依程序進行；切換標籤不會跳過量測，也不會改動器材。'));document.querySelectorAll('form[data-form]').forEach(f=>f.onsubmit=e=>{e.preventDefault();captureDraft();dispatch(f.dataset.form==='w'?'transcribeW':'calculate',f.dataset.form==='w'?{value:draft.w}:{difference:draft.difference,displaced:draft.displaced})});document.querySelectorAll('[data-edit]').forEach(b=>b.onclick=()=>{const r=records.find(x=>x.runId===b.dataset.edit),text=prompt('另存解釋修訂（原始讀值與原解釋不覆寫）',revisions[r.runId]?.at(-1)?.text||r.explanation);if(text===null)return;if(!text.trim())return announce('解釋不能是空白。');(revisions[r.runId]??=[]).push({text:text.trim(),at:new Date().toISOString()});persist();render()});}
let drag=null;
document.addEventListener('pointerdown',e=>{const t=e.target.closest('[data-drag]');if(!t||e.button!==0)return;drag={id:e.pointerId,x:e.clientX,y:e.clientY,target:t,kind:t.dataset.drag,runId:run.runId,revision:run.revision};t.setPointerCapture?.(e.pointerId)});
document.addEventListener('pointermove',e=>{if(!drag||e.pointerId!==drag.id)return;if(drag.kind==='object'&&run.hung&&e.clientY<drag.y-16)drag.target.classList.add('preview-up')});
function endDrag(e,cancel=false){hold.stop();if(!drag||e.pointerId!==drag.id)return;const d=drag;drag=null;d.target.classList.remove('preview-up');if(cancel||d.runId!==run.runId||d.revision!==run.revision)return;const dx=e.clientX-d.x,dy=e.clientY-d.y;if(Math.hypot(dx,dy)<18)return;if(d.kind==='object'){if(run.hung&&dy< -18)return confirmReset();if(!run.hung&&dy< -18)return dispatch('hang');if(run.hung&&dy>18)return dispatch('lower')}else{const rect=$('.bench').getBoundingClientRect(),x=(e.clientX-rect.left)/rect.width*800;if(x>625)dispatch('cupToScale');else if(x>470&&x<625)dispatch('cupToOutlet');else announce('把收集杯放到右側天平或溢流口；也可以使用操作按鈕。')}}
document.addEventListener('pointerup',e=>endDrag(e));document.addEventListener('pointercancel',e=>endDrag(e,true));document.addEventListener('lostpointercapture',e=>{hold.stop();if(drag?.id===e.pointerId)endDrag(e,true)});window.addEventListener('blur',()=>{hold.stop();if(drag)drag.target.classList.remove('preview-up');drag=null});document.addEventListener('visibilitychange',()=>{if(document.hidden){hold.stop();if(drag)drag.target.classList.remove('preview-up');drag=null}});render();
